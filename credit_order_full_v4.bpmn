    <textAnnotation id="TextAnnotation_13h99b3">
      <text>ТЭО - терминал электронной очереди</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_1cdz0rk">
      <text>На табло отображается электронная очередь, талоны и окна к которым нужно подойти</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_1t5t27d">
      <text>клиент не должен путаться в обстоятельствах получения кредита</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0x4xqun">
      <text>одна цифра(буква) в паспортных данных или номере телефона не соответствует</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0mxq0uz">
      <text>процентная ставка, срок погашения кредита, дата первого платежа, ежемесячный платеж, пени, штрафы, реквизиты банка</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0ahrfcb">
      <text>прописью сумму кредита и дату  оформления договора, поставить подпись и расшифровку подписи клиента, потавить печать</text>
    </textAnnotation>
    <association id="Association_0tb0wvi" associationDirection="None" sourceRef="Activity_1k9w6sg" targetRef="TextAnnotation_1t5t27d" />
    <association id="Association_1axc7ic" associationDirection="None" sourceRef="Activity_1x6rxwx" targetRef="TextAnnotation_0x4xqun" />
    <association id="Association_1ggcuz8" associationDirection="None" sourceRef="Activity_09lc7j9" targetRef="TextAnnotation_0mxq0uz" />
